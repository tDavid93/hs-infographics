---
import { ArrowUpRight, Sparkles } from "@lucide/astro";
import PageFrame from "../../components/PageFrame.astro";
import { mechanics, sources, updated } from "../../data/bg14-en";
import { languageLinks, navItems, siteCopy } from "../../data/site";
import "../../styles/global.css";

const copy = siteCopy.en;
const links = languageLinks.overview;
const date = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" }).format(new Date(`${updated}T12:00:00Z`));
---

<PageFrame
  lang="en"
  title={copy.title}
  description={copy.description}
  eyebrow={copy.eyebrow}
  lede={copy.lede}
  updatedLabel={copy.updated}
  date={date}
  navItems={navItems("en", "overview")}
  language={{ label: copy.languageLabel, ...links }}
>
  <section class="snapshot" aria-labelledby="snapshot-title">
    <div class="snapshot-main">
      <p class="eyebrow">Early community snapshot</p>
      <h2 id="snapshot-title">Engine first, tribe second</h2>
      <p>
        The current read favors repeatable engines over blind tribe forcing. Detailed comps, routes,
        and sources now live on separate pages so the guide is easier to navigate.
      </p>
    </div>
    <div class="rank-board" aria-label="Early comp ranking">
      {["S Quilboar", "A Mech", "A Beast", "A Murloc", "A Undead", "A Elemental", "B Naga", "B Pirate", "B Dragon", "C Demon"].map((rank) => (
        <span>{rank}</span>
      ))}
    </div>
  </section>

  <section class="mechanics" aria-label="Season 14 mechanics">
    {mechanics.map((item) => (
      <article>
        <Sparkles size={20} />
        <span>{item.name}</span>
        <strong>{item.value}</strong>
        <p>{item.detail}</p>
      </article>
    ))}
  </section>

  <section class="page-links" aria-label="Main pages">
    <a href="/en/comps/"><strong>Comps</strong><span>Core cards, commit signals, avoid lists.</span></a>
    <a href="/en/strategy/"><strong>Strategy</strong><span>Dark Gift timing, playbook, board states, and build routes.</span></a>
    <a href="/en/references/"><strong>References</strong><span>Patch data, community reads, and video references.</span></a>
  </section>

  <section class="notes" aria-labelledby="notes-title">
    <ArrowUpRight size={20} />
    <div>
      <h2 id="notes-title">Quick Sources</h2>
      <div class="source-list">
        {sources.map((source) => (
          <a href={source.href} target="_blank" rel="noreferrer">
            {source.label}
            <ArrowUpRight size={14} />
          </a>
        ))}
      </div>
    </div>
  </section>
</PageFrame>
