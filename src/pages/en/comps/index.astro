---
import CompsSection from "../../../components/CompsSection.astro";
import FilterToolbar from "../../../components/FilterToolbar.astro";
import PageFrame from "../../../components/PageFrame.astro";
import { comps, tribes, updated } from "../../../data/bg14-en";
import { languageLinks, navItems, siteCopy } from "../../../data/site";
import "../../../styles/global.css";

const copy = siteCopy.en;
const links = languageLinks.comps;
const date = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" }).format(new Date(`${updated}T12:00:00Z`));
---

<PageFrame lang="en" title={`Comps | ${copy.title}`} description={copy.description} eyebrow={copy.eyebrow} lede={copy.lede} updatedLabel={copy.updated} date={date} navItems={navItems("en", "comps")} language={{ label: copy.languageLabel, ...links }}>
  <FilterToolbar label="Filter" tribes={tribes} />
  <CompsSection comps={comps} ariaLabel="Battlegrounds Season 14 comps" cardAltSuffix="Hearthstone card art" metaLabel="Meta note" commitLabel="Commit When" avoidLabel="Avoid" statsJoiner="and" />
</PageFrame>
