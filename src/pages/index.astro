---
import { ArrowUpRight, CalendarClock, Filter, Info, Sparkles } from "@lucide/astro";
import { comps, giftTimeline, glossary, mechanics, playbook, sources, tribes, updated } from "../data/bg14";
import "../styles/global.css";

const cardArt = (cardId: string) =>
  `https://art.hearthstonejson.com/v1/512x/${cardId}.jpg`;

const date = new Intl.DateTimeFormat("hu-HU", {
  month: "short",
  day: "numeric",
  year: "numeric",
}).format(new Date(`${updated}T12:00:00Z`));
---

<html lang="hu">
      <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Magyar Hearthstone Battlegrounds 14. szezon segéd infografika aktuális compokkal, Dark Gifts tanácsokkal és HearthstoneJSON kártyaképekkel."
    />
    <link rel="alternate" hreflang="hu" href="/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <title>BG14 Meta Desk | Hearthstone Battlegrounds magyar segéd</title>
  </head>
  <body>
    <main class="shell">
      <header class="masthead">
        <div class="masthead-copy">
          <p class="eyebrow">Hearthstone Battlegrounds · 14. szezon</p>
          <h1>Dark Gifts Meta Desk</h1>
          <p class="lede">
            Tömör magyar segéd az early Season 14 döntésekhez: melyik engine-re érdemes ráállni,
            mely darabok számítanak, és mikor elég egy Dark Gift vagy Trinket a pivothoz.
          </p>
        </div>
        <div class="update-card" aria-label={`Frissítve: ${date}`}>
          <CalendarClock size={18} />
          <span>Frissítve</span>
          <strong>{date}</strong>
        </div>
        <nav class="language-switch" aria-label="Nyelvválasztó">
          <a class="active" href="/" aria-current="page">HU</a>
          <a href="/en/">EN</a>
        </nav>
      </header>

      <section class="snapshot" aria-labelledby="snapshot-title">
        <div class="snapshot-main">
          <p class="eyebrow">Korai közösségi snapshot</p>
          <h2 id="snapshot-title">Előbb engine, utána tribe</h2>
          <p>
            A jelenlegi olvasat az ismételhető engine-eket részesíti előnyben a vak tribe force-olással szemben.
            A Mech és a Quilboar skálázási loopja a legtisztább, a Murloc és az Undead erős, ha összeállnak
            a kulcstriggerek, a lassabb Dragon, Beast, Pirate, Naga vagy Demon vonalakhoz pedig élesebb lobby jel kell.
          </p>
        </div>
        <div class="rank-board" aria-label="Korai comp rangsor">
          {["S Mech", "S Quilboar", "A Murloc", "A Undead", "A Elemental", "B Naga", "B Pirate", "B Beast", "B Dragon", "C Demon"].map((rank) => (
            <span>{rank}</span>
          ))}
        </div>
      </section>

      <section class="mechanics" aria-label="Season 14 mechanikák">
        {mechanics.map((item) => (
          <article>
            <Sparkles size={20} />
            <span>{item.name}</span>
            <strong>{item.value}</strong>
            <p>{item.detail}</p>
          </article>
        ))}
      </section>

      <section class="strategy-section" aria-labelledby="gift-timing-title">
        <div class="section-head">
          <p class="eyebrow">Dark Gift timing</p>
          <h2 id="gift-timing-title">Mikor milyen ajánlatot kapsz?</h2>
          <p>
            A Dark Gift gomb a 3. körtől nyílik meg, és a felajánlott minion tierje körönként emelkedik.
            Ezért nem mindegy, hogy stabilizáló Giftet, engine-keresést vagy késői finishert akarsz.
          </p>
        </div>
        <div class="timeline-table">
          <div class="timeline-row timeline-header">
            <span>Kör</span>
            <span>Ajánlat</span>
            <span>Használat</span>
          </div>
          {giftTimeline.map((row) => (
            <div class="timeline-row">
              <strong>{row.turn}</strong>
              <span>{row.offer}</span>
              <p>{row.use}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="info-grid" aria-label="Játékterv és fogalomtár">
        {playbook.map((block) => (
          <article class="info-card">
            <h2>{block.title}</h2>
            <p>{block.body}</p>
            <ul>
              {block.points.map((point) => <li>{point}</li>)}
            </ul>
          </article>
        ))}
        {glossary.map((block) => (
          <article class="info-card glossary-card">
            <h2>{block.title}</h2>
            <p>{block.body}</p>
            <ul>
              {block.points.map((point) => <li>{point}</li>)}
            </ul>
          </article>
        ))}
      </section>

      <section class="toolbar" aria-label="Comp szűrés">
        <div>
          <Filter size={18} />
          <span>Szűrő</span>
        </div>
        <nav>
          {tribes.map((tribe) => (
            <button type="button" data-filter={tribe.key} class={tribe.key === "all" ? "active" : ""}>
              {tribe.label}
            </button>
          ))}
        </nav>
      </section>

      <section class="comps" aria-label="Battlegrounds Season 14 compok">
        {comps.map((comp) => (
          <article class="comp-card" data-tribe={comp.tribe}>
            <div class="comp-head">
              <div>
                <span class={`grade grade-${comp.grade.toLowerCase()}`}>{comp.grade}-tier</span>
                <h2>{comp.name}</h2>
                <p>{comp.why}</p>
              </div>
              <aside>
                <strong>{comp.signal}</strong>
              </aside>
            </div>

            <div class="card-strip" aria-label={`${comp.name} core kártyák`}>
              {comp.cards.map((card) => (
                <figure class="hs-card">
                  <div class="hs-card-face">
                    <div class="tier-gem" aria-label={`Tavern tier ${card.tier}`}>{card.tier}</div>
                    <div class="art-window">
                      <img
                        src={cardArt(card.cardId)}
                        alt={`${card.name} Hearthstone kártyakép`}
                        loading="lazy"
                        decoding="async"
                        data-card-name={card.name}
                        data-card-text={card.rules}
                      />
                    </div>
                    <div class="nameplate">{card.name}</div>
                    <div class="type-line">Tier {card.tier} · {card.type}</div>
                    <p class="rules" set:html={card.rules} />
                    <div class="stats" aria-label={`${card.attack} Attack és ${card.health} Health`}>
                      <span class="attack">{card.attack}</span>
                      <span class="health">{card.health}</span>
                    </div>
                  </div>
                  <figcaption class="meta-note">
                    <strong>Meta jegyzet</strong>
                    <span>{card.note}</span>
                  </figcaption>
                </figure>
              ))}
            </div>

            <div class="decision-grid">
              <section>
                <h3>Commit jel</h3>
                <ul>
                  {comp.commit.map((item) => <li>{item}</li>)}
                </ul>
              </section>
              <section>
                <h3>Kerüld</h3>
                <ul>
                  {comp.avoid.map((item) => <li>{item}</li>)}
                </ul>
              </section>
            </div>
          </article>
        ))}
      </section>

      <section class="notes" aria-labelledby="notes-title">
        <Info size={20} />
        <div>
          <h2 id="notes-title">Megbízhatósági jegyzet</h2>
          <p>
            Ez nem végleges win-rate tierlista. A Blizzard 36.2-es Season 14 kártya- és mechanikaadatait,
            a HSBG vizuális adatbázisát, a HearthstoneJSON képazonosítóit és a korai közösségi tapasztalatokat
            kombinálja. Balance változások és nagyobb tracker minták után a sorrend várhatóan mozogni fog.
          </p>
          <div class="source-list">
            {sources.map((source) => (
              <a href={source.href} target="_blank" rel="noreferrer">
                {source.label}
                <ArrowUpRight size={14} />
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <script>
      const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
      const cards = document.querySelectorAll<HTMLElement>("[data-tribe]");

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const filter = button.dataset.filter ?? "all";
          buttons.forEach((item) => item.classList.toggle("active", item === button));
          cards.forEach((card) => {
            card.hidden = filter !== "all" && card.dataset.tribe !== filter;
          });
        });
      });

      document.querySelectorAll<HTMLImageElement>(".art-window img").forEach((image) => {
        image.addEventListener("error", () => {
          const fallback = document.createElement("div");
          fallback.className = "render-fallback";
          fallback.innerHTML = `<strong>${image.dataset.cardName ?? "Kártya"}</strong><span>${image.dataset.cardText ?? "Kép nem elérhető"}</span>`;
          image.replaceWith(fallback);
        });
      });
    </script>
  </body>
</html>
