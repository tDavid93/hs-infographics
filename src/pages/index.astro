---
import { ArrowUpRight, Sparkles } from "@lucide/astro";
import PageFrame from "../components/PageFrame.astro";
import { mechanics, sources, updated } from "../data/bg14";
import { languageLinks, navItems, siteCopy } from "../data/site";
import "../styles/global.css";

const copy = siteCopy.hu;
const links = languageLinks.overview;
const date = new Intl.DateTimeFormat("hu-HU", { month: "short", day: "numeric", year: "numeric" }).format(new Date(`${updated}T12:00:00Z`));
---

<PageFrame
  lang="hu"
  title={copy.title}
  description={copy.description}
  eyebrow={copy.eyebrow}
  lede={copy.lede}
  updatedLabel={copy.updated}
  date={date}
  navItems={navItems("hu", "overview")}
  language={{ label: copy.languageLabel, ...links }}
>
  <section class="snapshot" aria-labelledby="snapshot-title">
    <div class="snapshot-main">
      <p class="eyebrow">Korai közösségi snapshot</p>
      <h2 id="snapshot-title">Előbb engine, utána tribe</h2>
      <p>
        A jelenlegi olvasat az ismételhető engine-eket részesíti előnyben a vak tribe force-olással szemben.
        A részletes compok, route-ok és források külön oldalakra kerültek, hogy gyorsabban lehessen navigálni.
      </p>
    </div>
    <div class="rank-board" aria-label="Korai comp rangsor">
      {["S Mech", "S Quilboar", "A Beast", "A Murloc", "A Undead", "A Elemental", "B Naga", "B Pirate", "B Dragon", "C Demon"].map((rank) => (
        <span>{rank}</span>
      ))}
    </div>
  </section>

  <section class="mechanics" aria-label="Season 14 mechanikák">
    {mechanics.map((item) => (
      <article>
        <Sparkles size={20} />
        <span>{item.name}</span>
        <strong>{item.value}</strong>
        <p>{item.detail}</p>
      </article>
    ))}
  </section>

  <section class="page-links" aria-label="Fő oldalak">
    <a href="/comps/"><strong>Compok</strong><span>Core kártyák, commit jelek, kerülendő csapdák.</span></a>
    <a href="/strategy/"><strong>Stratégia</strong><span>Dark Gift timing, playbook, board state-ek és build route-ok.</span></a>
    <a href="/references/"><strong>Források</strong><span>Patchadatok, közösségi olvasat, videós referenciák.</span></a>
  </section>

  <section class="notes" aria-labelledby="notes-title">
    <ArrowUpRight size={20} />
    <div>
      <h2 id="notes-title">Gyors források</h2>
      <div class="source-list">
        {sources.map((source) => (
          <a href={source.href} target="_blank" rel="noreferrer">
            {source.label}
            <ArrowUpRight size={14} />
          </a>
        ))}
      </div>
    </div>
  </section>
</PageFrame>
