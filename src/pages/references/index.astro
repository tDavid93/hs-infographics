---
import { ArrowUpRight, Info } from "@lucide/astro";
import PageFrame from "../../components/PageFrame.astro";
import StrategySections from "../../components/StrategySections.astro";
import { changelog, communityPulse, referenceNotes, sources, updated } from "../../data/bg14";
import { languageLinks, navItems, siteCopy } from "../../data/site";
import "../../styles/global.css";

const copy = siteCopy.hu;
const links = languageLinks.references;
const date = new Intl.DateTimeFormat("hu-HU", { month: "short", day: "numeric", year: "numeric" }).format(new Date(`${updated}T12:00:00Z`));
const confidenceLabels = { high: "magas", medium: "közepes", low: "alacsony" } as const;
---

<PageFrame lang="hu" title={`Források | ${copy.title}`} description={copy.description} eyebrow={copy.eyebrow} lede={copy.lede} updatedLabel={copy.updated} date={date} navItems={navItems("hu", "references")} language={{ label: copy.languageLabel, ...links }}>
  <section class="strategy-section pulse-section" aria-labelledby="community-pulse-title">
    <div class="section-head">
      <p class="eyebrow">Közösségi pulzus</p>
      <h2 id="community-pulse-title">Mi változott a közösségi olvasatban?</h2>
      <p>Frissítve: {date}. A Reddit és creator jelek highrollokat, vitákat és döntési mintákat mutatnak; ez nem helyettesíti a hivatalos patchadatot vagy valódi win-rate statisztikát.</p>
    </div>
    <div class="pulse-grid">
      {communityPulse.map((item) => (
        <article class="pulse-card">
          <div class="pulse-topline">
            <span class={`confidence confidence-${item.confidence}`}>{confidenceLabels[item.confidence]}</span>
            <span>Bizalom</span>
          </div>
          <h3>{item.title}</h3>
          <dl>
            <dt>Jel</dt>
            <dd>{item.signal}</dd>
            <dt>Következtetés</dt>
            <dd>{item.takeaway}</dd>
          </dl>
          <div class="pulse-sources" aria-label="Források">
            {item.sources.map((source) => <span>{source}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="strategy-section changelog-section" aria-labelledby="changelog-title">
    <div class="section-head">
      <p class="eyebrow">Változásnapló</p>
      <h2 id="changelog-title">Site frissítések</h2>
      <p>Itt követhető, mikor milyen tartalmi, nyelvi vagy stratégiai frissítés került be az oldalra.</p>
    </div>
    <div class="changelog-list">
      {changelog.map((entry) => (
        <article class="changelog-item">
          <time datetime={entry.date}>{new Intl.DateTimeFormat("hu-HU", { month: "short", day: "numeric", year: "numeric" }).format(new Date(`${entry.date}T12:00:00Z`))}</time>
          <div>
            <h3>{entry.title}</h3>
            <p>{entry.summary}</p>
            <ul>
              {entry.changes.map((change) => <li>{change}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>
  <StrategySections boardStates={[]} buildRoutes={[]} referenceNotes={referenceNotes} labels={{ boardsEyebrow: "", boardsTitle: "", boardsBody: "", boardLabel: "", handLabel: "", nextLabel: "", routesAria: "", opener: "", midgame: "", late: "", pivots: "", refsEyebrow: "Elemzett referenciák", refsTitle: "Mire épül az oldal?", refsBody: "A hivatalos patchadatot külön kezeljük a közösségi és videós tapasztalatoktól." }} />
  <section class="notes" aria-labelledby="notes-title">
    <Info size={20} />
    <div>
      <h2 id="notes-title">Forráslista</h2>
      <div class="source-list">{sources.map((source) => <a href={source.href} target="_blank" rel="noreferrer">{source.label}<ArrowUpRight size={14} /></a>)}</div>
    </div>
  </section>
</PageFrame>
